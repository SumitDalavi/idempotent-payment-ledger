# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: idempotent-payment-ledger
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory SQLite double-entry ledger with memory locks.
#
# TIER 2 / TIER 3: PRODUCTION POSTGRESQL & REDIS DISTRIBUTED LOCKS
# - Supply ACID database URL and Redis cluster for distributed idempotency keys.

DATABASE_URL=postgresql://user:pass@localhost:5432/ledger_db
REDIS_URL=redis://localhost:6379
PORT=3000
